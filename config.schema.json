{
    "pluginAlias": "NordpoolCheapestRange",
    "pluginType": "platform",
    "headerDisplay": "config.headerDisplay",
    "schema": {
        "type": "object",
        "properties": {
            "name": {
                "title": "config.name.title",
                "type": "string",
                "required": true,
                "default": "Nordpool",
                "description": "config.name.description"
            },
            "area": {
                "title": "config.area.title",
                "type": "string",
                "required": true,
                "default": "FI",
                "oneOf": [
                    {
                        "title": "Finland (FI)",
                        "enum": [
                            "FI"
                        ]
                    },
                    {
                        "title": "Estonia (EE)",
                        "enum": [
                            "EE"
                        ]
                    },
                    {
                        "title": "Lithuania (LT)",
                        "enum": [
                            "LT"
                        ]
                    },
                    {
                        "title": "Latvia (LV)",
                        "enum": [
                            "LV"
                        ]
                    },
                    {
                        "title": "Sweden (SE1-SE4)",
                        "enum": [
                            "SE1",
                            "SE2",
                            "SE3",
                            "SE4"
                        ]
                    },
                    {
                        "title": "Norway (NO1-NO5)",
                        "enum": [
                            "NO1",
                            "NO2",
                            "NO3",
                            "NO4",
                            "NO5"
                        ]
                    }
                ]
            },
            "decimalPrecision": {
                "title": "config.precision.title",
                "type": "integer",
                "default": 1,
                "oneOf": [
                    {
                        "title": "0 Decimals",
                        "enum": [
                            0
                        ]
                    },
                    {
                        "title": "1 Decimal",
                        "enum": [
                            1
                        ]
                    },
                    {
                        "title": "2 Decimals",
                        "enum": [
                            2
                        ]
                    }
                ]
            },
            "devices": {
                "title": "config.devices.title",
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "name": {
                            "title": "config.device.name.title",
                            "type": "string",
                            "required": true
                        },
                        "cheapestHours": {
                            "title": "config.device.hours.title",
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 24,
                            "default": 3,
                            "description": "config.device.hours.description"
                        },
                        "rangeStart": {
                            "title": "config.device.start.title",
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 23,
                            "default": 0
                        },
                        "rangeEnd": {
                            "title": "config.device.end.title",
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 23,
                            "default": 23
                        }
                    }
                }
            }
        }
    }
}