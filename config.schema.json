{
    "pluginAlias": "NordpoolCheapestRange",
    "pluginType": "platform",
    "headerDisplay": "Nordpool Cheapest Range",
    "schema": {
        "type": "object",
        "properties": {
            "name": {
                "title": "Plugin Name",
                "type": "string",
                "required": true,
                "default": "Nordpool"
            },
            "area": {
                "title": "Area",
                "type": "string",
                "required": true,
                "default": "FI",
                "oneOf": [
                    { "title": "Finland (FI)", "enum": ["FI"] },
                    { "title": "Estonia (EE)", "enum": ["EE"] },
                    { "title": "Lithuania (LT)", "enum": ["LT"] },
                    { "title": "Latvia (LV)", "enum": ["LV"] },
                    { "title": "Sweden (SE1-SE4)", "enum": ["SE1", "SE2", "SE3", "SE4"] },
                    { "title": "Norway (NO1-NO5)", "enum": ["NO1", "NO2", "NO3", "NO4", "NO5"] }
                ]
            },
            "decimalPrecision": {
                "title": "Decimal Precision",
                "type": "integer",
                "default": 2,
                "oneOf": [
                    { "title": "0 Decimals", "enum": [0] },
                    { "title": "1 Decimal", "enum": [1] },
                    { "title": "2 Decimals", "enum": [2] }
                ]
            },
            "devices": {
                "title": "Devices",
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "name": {
                            "title": "Device Name",
                            "type": "string",
                            "required": true
                        },
                        "cheapestHours": {
                            "title": "Cheapest Hours",
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 24,
                            "default": 3
                        },
                        "rangeStart": {
                            "title": "Range Start (Hour)",
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 23,
                            "default": 0
                        },
                        "rangeEnd": {
                            "title": "Range End (Hour)",
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 23,
                            "default": 23
                        }
                    }
                }
            }
        }
    }
}
