{
    "pluginAlias": "NordpoolBaltics",
    "pluginType": "platform",
    "schema": {
        "type": "object",
        "properties": {
            "name": {
                "title": "Bridge Name",
                "type": "string",
                "required": true,
                "default": "Nordpool",
                "description": "Name shown in Homebridge logs and Home app."
            },
            "area": {
                "title": "Nordpool Market Area",
                "type": "string",
                "required": true,
                "default": "FI",
                "oneOf": [
                    {
                        "title": "Finland",
                        "enum": [
                            "FI"
                        ]
                    },
                    {
                        "title": "Lithuania",
                        "enum": [
                            "LT"
                        ]
                    },
                    {
                        "title": "Latvia",
                        "enum": [
                            "LV"
                        ]
                    },
                    {
                        "title": "Estonia",
                        "enum": [
                            "EE"
                        ]
                    },
                    {
                        "title": "Sweden SE1",
                        "enum": [
                            "SE1"
                        ]
                    },
                    {
                        "title": "Sweden SE2",
                        "enum": [
                            "SE2"
                        ]
                    },
                    {
                        "title": "Sweden SE3",
                        "enum": [
                            "SE3"
                        ]
                    },
                    {
                        "title": "Sweden SE4",
                        "enum": [
                            "SE4"
                        ]
                    },
                    {
                        "title": "Norway NO1",
                        "enum": [
                            "NO1"
                        ]
                    },
                    {
                        "title": "Norway NO2",
                        "enum": [
                            "NO2"
                        ]
                    },
                    {
                        "title": "Norway NO3",
                        "enum": [
                            "NO3"
                        ]
                    },
                    {
                        "title": "Norway NO4",
                        "enum": [
                            "NO4"
                        ]
                    },
                    {
                        "title": "Norway NO5",
                        "enum": [
                            "NO5"
                        ]
                    },
                    {
                        "title": "Denmark DK1",
                        "enum": [
                            "DK1"
                        ]
                    },
                    {
                        "title": "Denmark DK2",
                        "enum": [
                            "DK2"
                        ]
                    },
                    {
                        "title": "Germany",
                        "enum": [
                            "DE"
                        ]
                    },
                    {
                        "title": "Austria",
                        "enum": [
                            "AT"
                        ]
                    }
                ]
            },
            "decimalPrecision": {
                "title": "Price Decimal Precision",
                "type": "integer",
                "default": 1,
                "oneOf": [
                    {
                        "title": "0 Decimals (e.g. 4)",
                        "enum": [
                            0
                        ]
                    },
                    {
                        "title": "1 Decimal (e.g. 4.6)",
                        "enum": [
                            1
                        ]
                    },
                    {
                        "title": "2 Decimals (e.g. 4.68)",
                        "enum": [
                            2
                        ]
                    }
                ]
            },
            "devices": {
                "title": "Dynamic Price Sensors (Devices)",
                "type": "array",
                "items": {
                    "type": "object",
                    "title": "Sensor Settings",
                    "properties": {
                        "name": {
                            "title": "Sensor Name",
                            "type": "string",
                            "required": true,
                            "placeholder": "e.g. Water Heater",
                            "description": "Unique name for this sensor."
                        },
                        "cheapestHours": {
                            "title": "Number of Cheapest Hours",
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 24,
                            "default": 3,
                            "description": "Pick the X cheapest hours within the time range."
                        },
                        "rangeStart": {
                            "title": "Search Range Start (0-23)",
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 23,
                            "default": 0,
                            "description": "The hour to start looking for cheap electricity."
                        },
                        "rangeEnd": {
                            "title": "Search Range End (0-23)",
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 23,
                            "default": 23,
                            "description": "The hour to stop looking for cheap electricity."
                        }
                    }
                }
            }
        }
    }
}